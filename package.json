{
  "name": "openfuture",
  "productName": "OpenFuture",
  "version": "0.1.0",
  "private": true,
  "description": "OpenFuture - a local-first Windows desktop agent built on the Pi SDK",
  "author": "OpenFuture",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.node.json && node node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.web.json",
    "mock-model": "node tools/mock-model/server.mjs",
    "package": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "billion-context-pi": "0.1.83",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
